PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration:
# Provide a MongoDB connection string (e.g. mongodb://localhost:27017/careerforge or MongoDB Atlas URI).
# If left empty, the server will automatically use an in-memory MongoDB instance for development.
MONGO_URI=mongodb://localhost:27017/careerforge

# JWT secret key for signing authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# AI Interviewer Configuration (Google Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Platform Producer (Admin notifications & OTP recipient)
PRODUCER_EMAIL=admin@example.com

# SMTP Email Configuration (for password resets & system alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM="CareerForge Platform" <noreply@careerforge.io>
